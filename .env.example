# Environment Variables Configuration for Wikipedia Maintenance Tool
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials to version control

# ================================
# PYWIKIBOT CONFIGURATION (AUTOMATIC)
# ================================
# This is automatically set by the application to the project root
# PYWIKIBOT_DIR is set dynamically and should not be changed manually

# ================================
# WIKIPEDIA CREDENTIALS (REQUIRED)
# ================================
# Alternatively, you can configure these in passwords.py
WIKIPEDIA_USERNAME=your_wikipedia_username
WIKIPEDIA_PASSWORD=your_wikipedia_password

# ================================
# GEMINI AI CREDENTIALS (OPTIONAL)
# ================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_PROJECT_ID=your_gemini_project_id
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_LIMIT=10800

# ================================
# TELEGRAM BOT CREDENTIALS (OPTIONAL)
# ================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_IDS=123456789,987654321

# ================================
# OLLAMA AI CREDENTIALS (OPTIONAL - for local AI)
# ================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:instruct
OLLAMA_FALLBACK=llama3:instruct

# ================================
# BOT IDENTITY (OPTIONAL)
# ================================
# Bot name for Wikipedia identification
BOT_NAME=YourBotName
# Bot version
BOT_VERSION=1.0
# Operator name
OPERATOR_NAME=YourOperatorName
# Operator contact page (Wikipedia user talk page)
OPERATOR_CONTACT=https://fr.wikipedia.org/wiki/Discussion_utilisateur:YourOperatorName
# Bot discussion page
BOT_DISCUSSION=https://fr.wikipedia.org/wiki/Discussion_utilisateur:YourBotName
# Repository URL
REPOSITORY=https://github.com/Sabrsl/OviX
# IMPORTANT: Set to true ONLY after Wikipedia bot approval
# Without approval, must be false to use human-like User-Agent
USE_BOT_USER_AGENT=false

# ================================
# APPLICATION SETTINGS
# ================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Service name for structured logging
SERVICE_NAME=wikipedia_maintenance

# Dry run mode (true/false) - Set to true for testing without actual changes
DRY_RUN=true

# ================================
# SECURITY NOTES
# ================================
# 1. Never share your .env file or commit it to version control
# 2. Use strong, unique passwords for Wikipedia
# 3. Rotate API keys regularly
# 4. Monitor your Wikipedia bot account for suspicious activity
# 5. Use environment-specific .env files for development/staging/production

# ================================
# API SETTINGS
# ================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# PROJECT CONFIGURATION (AUTOMATIC)
# ================================
# PROJECT_ROOT is automatically set by the application to the project root
# PYWIKIBOT_DIR is automatically set to the project root for Pywikibot configuration
