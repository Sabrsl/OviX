# OVIX Frontend Environment Variables
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control

# ============================================
# API CONFIGURATION
# ============================================
# Backend API base URL (required for production)
# In development, this defaults to http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Optional: Custom API timeouts (in milliseconds)
# VITE_API_TIMEOUT=300000 (5 minutes for long operations)
# VITE_API_QUICK_TIMEOUT=10000 (10 seconds for quick calls)

# ============================================
# DEVELOPMENT SERVER CONFIGURATION (OPTIONAL)
# ============================================
# Vite dev server port (default: 3000)
# VITE_DEV_PORT=3000

# Vite dev server host (default: 127.0.0.1)
# VITE_DEV_HOST=127.0.0.1

# ============================================
# NOTES
# ============================================
# 1. All VITE_ prefixed variables are automatically available in the frontend
# 2. In development, the Vite proxy handles /api requests to the backend
# 3. In production, set VITE_API_BASE_URL to your actual backend URL
# 4. Timeouts can be adjusted based on your network conditions
